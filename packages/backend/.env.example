# Copy to .env and fill in your keys: cp .env.example .env

# ── CLOUD AI: Anthropic Claude ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_ADVANCED=claude-opus-4-8

DEFAULT_FAST_MODEL=claude-haiku-4-5-20251001
DEFAULT_STANDARD_MODEL=claude-sonnet-4-6
DEFAULT_ADVANCED_MODEL=claude-opus-4-8

# ── CLOUD AI: OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_FAST=gpt-4o-mini
OPENAI_MODEL=gpt-4o
OPENAI_ADVANCED=gpt-4o

# ── CLOUD AI: Google Gemini ─────────────────────────────────────────────────
GEMINI_API_KEY=

# ── LOCAL AI: Ollama ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING_MODEL=deepseek-r1:8b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_VISION_MODEL=llava:7b

# ── AI Backend Mode ─────────────────────────────────────────────────────────
# Governs TEXT generation (planning/UI/code). auto | cloud | ollama
AI_BACKEND_MODE=auto

# ── Vision (image analysis) Backend ────────────────────────────────────────
# Reading an uploaded reference image (the "recreate"/"redesign from screenshot"
# flow) is resolved INDEPENDENTLY of AI_BACKEND_MODE above — local vision models
# are noticeably weaker at accurately transcribing screenshot text than cloud
# models, so this always prefers the best available cloud key even if
# AI_BACKEND_MODE=ollama is set for text generation, to save cost there.
# auto (default, best available key wins: anthropic > openai > gemini > ollama)
# | anthropic | openai | gemini | ollama (pin a specific backend)
VISION_PROVIDER=auto

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret

# ── Storage ─────────────────────────────────────────────────────────────────
UPLOADS_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── Optional ────────────────────────────────────────────────────────────────
# FIGMA_API_KEY=
