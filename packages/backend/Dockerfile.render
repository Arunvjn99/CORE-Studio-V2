# Render deployment image — runs the SQLite-based local server (server_local.py),
# the fully-tested, feature-complete implementation this repo's test suite and every
# live end-to-end verification in this project targets. Kept separate from the main
# Dockerfile (which builds app/main.py against Postgres/Redis for the docker-compose
# stack) so neither deployment path disturbs the other.
#
# Render free-tier disk is ephemeral — the SQLite file resets on each redeploy/restart.
# For persistent data, swap DATABASE_URL-style storage in server_local.py for the
# Postgres instance already provisioned alongside this service, or attach a Render Disk.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-local.txt .
RUN pip install --no-cache-dir -r requirements-local.txt

COPY . .

EXPOSE 8000
CMD ["sh", "-c", "uvicorn server_local:app --host 0.0.0.0 --port ${PORT:-8000}"]
