# Render deployment image — runs the SQLite-based local server (server_local.py),
# the fully-tested, feature-complete implementation this repo's test suite and every
# live end-to-end verification in this project targets. Kept separate from the main
# Dockerfile (which builds app/main.py against Postgres/Redis for the docker-compose
# stack) so neither deployment path disturbs the other.
#
# Build context is scoped to packages/backend/ (Render's rootDir) — the proven-reliable
# configuration for this platform's port auto-detection (a repo-root-scoped context
# triggered a persistent "no open ports detected" false negative on Render, even with
# the exact same CMD/EXPOSE). Since that scoping can't COPY the top-level knowledge/
# folder directly, it's fetched via a sparse git clone at build time instead, into a
# path that still matches how server_local.py resolves it
# (BASE_DIR.parent.parent / "knowledge", two directories up from server_local.py) by
# mirroring the monorepo's packages/backend + knowledge/ layout inside the image.
#
# Render free-tier disk is ephemeral — the SQLite file and the seeded ChromaDB store
# reset on each redeploy/restart. For persistent data, swap DATABASE_URL-style storage
# in server_local.py for the Postgres instance already provisioned alongside this
# service, or attach a Render Disk.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-local.txt ./packages/backend/requirements-local.txt
RUN pip install --no-cache-dir -r packages/backend/requirements-local.txt

COPY . ./packages/backend

# Fetch just the knowledge/ folder from the public repo (build context here is scoped
# to packages/backend, so it can't be reached via a local COPY ../.. path).
RUN git clone --depth 1 --filter=blob:none --sparse https://github.com/Arunvjn99/CORE-Studio-V2.git /tmp/repo \
    && cd /tmp/repo && git sparse-checkout set knowledge \
    && cp -r knowledge /app/knowledge \
    && rm -rf /tmp/repo

WORKDIR /app/packages/backend

EXPOSE 8000
CMD ["sh", "-c", "uvicorn server_local:app --host 0.0.0.0 --port ${PORT:-8000}"]
